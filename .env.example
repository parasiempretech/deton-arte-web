# Acceso al panel privado. Usá una contraseña larga y exclusiva.
ADMIN_PASSWORD=

# Generá un valor aleatorio de 32 bytes o más.
ADMIN_SESSION_SECRET=

# URL pública del sitio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: ruta absoluta para las imágenes administradas.
# En Hostinger se usa automáticamente una carpeta persistente fuera de nodejs.
GALLERY_STORAGE_PATH=
