# Acceso al panel privado. Usá una contraseña larga y exclusiva.
ADMIN_PASSWORD=

# Generá un valor aleatorio de 32 bytes o más.
ADMIN_SESSION_SECRET=

# URL pública del sitio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Producción: conectá un Blob Store público.
# Vercel la agrega automáticamente; en otros proveedores, cargala manualmente.
BLOB_READ_WRITE_TOKEN=
